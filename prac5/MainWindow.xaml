<Window x:Class="Практика5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Даты в XML" Height="450" Width="700">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="День"/>
                <TextBox x:Name="DayBox" Width="150"/>
            </StackPanel>

            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="Месяц"/>
                <TextBox x:Name="MonthBox" Width="80"/>
            </StackPanel>

            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="Год"/>
                <TextBox x:Name="YearBox" Width="200"/>
            </StackPanel>

            <Button Content="Добавить дату" Width="90" Margin="10 0 0 0"
                    Click="AddButton_Click"/>
        </StackPanel>

        <!-- Список дат -->
        <ListView x:Name="DatesList" Grid.Row="1" Margin="0 0 0 10" 
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="День" DisplayMemberBinding="{Binding Day}" Width="150"/>
                    <GridViewColumn Header="Месяц" DisplayMemberBinding="{Binding Month}" Width="80"/>
                    <GridViewColumn Header="Год" DisplayMemberBinding="{Binding Year}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Панель поиска -->
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBox x:Name="SearchBox" Width="200" Margin="0 0 10 0"/>
            <Button Content="Найти" Width="90" Click="SearchButton_Click"/>
            <Button Content="Сбросить" Width="90" Margin="10 0 0 0"
                    Click="ResetButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
