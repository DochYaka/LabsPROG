<Window x:Class="WorkerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рассмотрение кандидата"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кандидат -->
        <TextBlock Text="{Binding CandidateInfo}"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Вакансия -->
        <TextBlock Grid.Row="1"
                   Text="{Binding VacancyInfo}"
                   Margin="0,0,0,10"/>

        <!-- Комментарий -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Комментарий:"/>
            <TextBox Text="{Binding Comment}"
                     AcceptsReturn="True"
                     Height="80"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Принять"
                    Width="90"
                    Margin="5"
                    Click="Accept_Click"/>

            <Button Content="Отклонить"
                    Width="90"
                    Margin="5"
                    Click="Reject_Click"/>

            <Button Content="Отмена"
                    Width="90"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
