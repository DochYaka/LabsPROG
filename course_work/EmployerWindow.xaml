<Window x:Class="EmployerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EmployerWindow" Height="500" Width="1200" 
        Loaded="Window_Loaded" WindowStartupLocation="CenterOwner">
    <Grid>
        <DockPanel x:Name="MainDockPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
            <StackPanel DockPanel.Dock="Top" Width="auto" Height="auto">
                <TextBox Margin="5" Height="30" x:Name="tbNameEmployer" Tag="tbHintNameEmployer" FontSize="20" 
                         TextChanged="TextBox_Changed" GotFocus="TextBox_Changed" LostFocus="TextBox_Changed"/>
                <TextBlock Margin="5" FontSize="20" x:Name="tbHintNameEmployer" Text="Введите название компании" IsHitTestVisible="False"/>

                <TextBox Margin="5" Height="30" x:Name="tbFullNameHR" Tag="tbHintFullNameHR" FontSize="20"
                         TextChanged="TextBox_Changed" GotFocus="TextBox_Changed" LostFocus="TextBox_Changed"/>
                <TextBlock Margin="5" FontSize="20" x:Name="tbHintFullNameHR" Text="Введите ИФ HR компании" IsHitTestVisible="False"/>
                <Button x:Name="LoginButton" Margin="0, 20, 0, 0" Content="Войти" Background="OrangeRed"
                        Click="Login_Click"/>

                <Button x:Name="btnRegistr" Margin="0, 20, 0, 0" Content="Зарегистрироваться" Background="GreenYellow"
                        Click="RegistrWindow_Click"/>
            </StackPanel>
        </DockPanel>

        <DockPanel x:Name="lvDockPanel" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="tbProfile" Text="Профиль: " FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" Width="auto">
                <TextBlock Text="Вакансии:" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ListView x:Name="lvVacancy" SelectionChanged="lvVacancy_SelectionChanged" Focusable="False">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="JobDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Должность"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="JobDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>


                            <GridViewColumn Width="auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="EducationDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Образование"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="EducationDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>


                            <GridViewColumn Width="auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="ExperienceDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Опыт"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="ExperienceDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>


                            <GridViewColumn Width="auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="WagesDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Зарплата"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="WagesDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="DistrictDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Район"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="DistrictDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>


                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Width="200" Height="auto" Content="Удалить" Background="LightBlue" 
                    Click="RemoveVacancy_Click" />
            </StackPanel>

            <DockPanel>
                <StackPanel Width="auto" DockPanel.Dock="Top">
                    <!-- Панель ввода данных -->
                    <WrapPanel Margin="10" Background="LightBlue">
                        <!-- Должность -->
                        <StackPanel Width="150" Margin="5">
                            <TextBlock Text="Должность" FontWeight="Bold"/>
                            <ComboBox x:Name="cbJob"/>
                        </StackPanel>

                        <!-- Образование -->
                        <StackPanel Width="130" Margin="5">
                            <TextBlock Text="Образование" FontWeight="Bold"/>
                            <ComboBox x:Name="cbEducation"/>
                        </StackPanel>

                        <!-- Опыт работы -->
                        <StackPanel Width="110" Margin="5">
                            <TextBlock Text="Опыт (лет)" FontWeight="Bold"/>
                            <TextBox x:Name="tbExperience" Text="0" ToolTip="Пример: 1.3"/>
                            <TextBlock Text="(0-50 лет)" FontSize="10" Foreground="Gray" 
      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Зарплата -->
                        <StackPanel Width="130" Margin="5">
                            <TextBlock Text="Зарплата (руб.)" FontWeight="Bold"/>
                            <TextBox x:Name="tbWages" Text="30000"/>
                            <TextBlock Text="(1000-999999)" FontSize="10" Foreground="Gray" 
                                HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Район -->
                        <StackPanel Width="160" Margin="5">
                            <TextBlock Text="Район" FontWeight="Bold"/>
                            <ComboBox x:Name="cbDistrict"/>
                        </StackPanel>
                    </WrapPanel>
                    <!-- Кнопки управления -->
                    <StackPanel Width="120" Margin="10" HorizontalAlignment="Left">
                        <Button x:Name="btnAddVacancy" Content="Добавить" 
                            Click="AddVacancy_Click" Height="35" Margin="0,0,0,8"
                            Background="LightGreen" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <ListView x:Name="lvRequest" Visibility="Collapsed" Width="auto" HorizontalAlignment="Center"
                          MouseDoubleClick="lvRequests_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="160">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="LastName">
                                        <StackPanel>
                                            <TextBlock Text="ФИО"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="FullName"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="130">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="DesiredJob">
                                        <StackPanel>
                                            <TextBlock Text="Должность"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="DesiredJob"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="130">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="EducationDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Образование"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="EducationDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="ExperienceDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Опыт"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="ExperienceDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="StatusDisplay">
                                        <StackPanel>
                                            <TextBlock Text="Статус"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="StatusDisplay"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
